<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Sources named here, so a restore on any machine reads the same feeds whatever that machine's own config says:
    nuget.org, and the local feed Snail.Sdk is packed into while it is unreleased (the folder beside mcp/).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="LocalPackages" value="../../nuget" />
  </packageSources>

  <!--
    Central package management with more than one feed configured requires an explicit mapping
    (NU1507). Without it a public package can shadow a private one of the same name, which is the
    dependency-confusion attack. The longest matching pattern wins, so Snail.Sdk.* resolves to the local feed.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LocalPackages">
      <package pattern="Snail.Sdk" />
      <package pattern="Snail.Sdk.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
