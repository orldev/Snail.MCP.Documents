<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Sources named here, so a restore on any machine reads the same feeds whatever that machine's own config says:
    nuget.org.

    Temporary, until Snail.Sdk 0.5.0 is on NuGet: the list is not cleared, so the LocalPackages feed each machine
    registers in its own configuration (its path differs between this machine and the build host) stays visible, and
    the mapping below routes Snail.Sdk and its packages to it alone. After the release <clear /> comes back and the
    LocalPackages mapping goes.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    Central package management with more than one feed configured requires an explicit mapping (NU1507). Without it a
    public package can shadow a private one of the same name, which is the dependency-confusion attack.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LocalPackages">
      <package pattern="Snail.Sdk" />
      <package pattern="Snail.Sdk.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
