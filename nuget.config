<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- One source, named here, so a restore on any machine reads the same feed whatever that machine's own config says. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
